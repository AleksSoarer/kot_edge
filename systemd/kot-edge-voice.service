[Unit]
Description=Kot Edge wake phrase and ASR service
Requires=kot-edge.service
After=kot-edge.service sound.target

[Service]
Type=simple
User=khadas
LogsDirectory=kot-edge
LogsDirectoryMode=0750
UMask=0077
WorkingDirectory=/home/khadas/kot_edge
Environment=PYTHONUNBUFFERED=1
Environment=KOT_EDGE_URL=http://127.0.0.1:8765
Environment=KOT_VOICE_BASE=/home/khadas/voice-assistant
Environment=KOT_WAKE_BACKEND=asr
Environment=KOT_MIC_BEAM_CHANNEL=7
Environment=KOT_WAKE_CHANNEL=8
Environment=KOT_MIC_LED_DEVICE=/dev/ttyACM0
Environment=KOT_AUTO_BEAM=1
Environment=KOT_AUTO_BEAM_NO_FRAME_WARNING_SECONDS=5.0
Environment=KOT_AUTO_BEAM_DIAGNOSTIC_SECONDS=15.0
Environment=KOT_MIC_LED_ON_WAKE=1
Environment=KOT_RECOGNITION_LOG=/var/log/kot-edge/recognition.jsonl
Environment=KOT_RECOGNITION_LOG_MAX_BYTES=10485760
Environment=KOT_RECOGNITION_LOG_BACKUPS=5
Environment=KOT_RECOGNITION_LOG_MODE=all
Environment=KOT_MUSIC_WAKE_MUTE_SECONDS=3.0
Environment=KOT_AEC_ENABLED=0
Environment=KOT_AEC_MONITOR_SOURCE=alsa_output.platform-auge_sound.stereo-fallback.monitor
Environment=KOT_AEC_MIC_SOURCE=alsa_input.usb-SipeedUSB_SipeedUSB_MicArray_2025082211-00.analog-surround-71
Environment=KOT_AEC_MIC_CHANNEL=4
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
# For the optional VIM3 NPU runner:
# Environment="KOT_NPU_WAKE_COMMAND=/opt/kot-npu/kot-wake-runner --model /opt/kot-npu/hey-kot.nb"
ExecStart=/home/khadas/kot_edge/.venv/bin/python -m kot.voice
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
