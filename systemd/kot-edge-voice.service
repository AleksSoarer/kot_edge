[Unit]
Description=Kot Edge wake phrase and ASR service
Requires=kot-edge.service
After=kot-edge.service sound.target

[Service]
Type=simple
User=khadas
WorkingDirectory=/home/khadas/kot_edge
Environment=PYTHONUNBUFFERED=1
Environment=KOT_EDGE_URL=http://127.0.0.1:8765
Environment=KOT_VOICE_BASE=/home/khadas/voice-assistant
ExecStart=/home/khadas/kot_edge/.venv/bin/python -m kot.voice
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
